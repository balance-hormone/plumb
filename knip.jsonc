{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // The hook runs from .claude/settings.json, which knip does not read. The CLI is
  // reached through `bin` (dist/esm/cli.mjs), which knip cannot map back to src.
  "entry": [".claude/hooks/*.mjs", "src/cli.ts"],
  // The Medplum peers are installed as devDependencies; none is imported until the generator lands.
  "ignoreDependencies": ["@medplum/core", "@medplum/definitions", "@medplum/fhirtypes"]
}
