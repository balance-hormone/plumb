{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // The hook runs from .claude/settings.json, which knip does not read. The library
  // and CLI are reached through `exports` and `bin` (dist/), which knip cannot map
  // back to src.
  "entry": [".claude/hooks/*.mjs", "src/index.ts", "src/testing.ts", "src/vitest.ts", "src/cli.ts"],
  // Golden files are compared as text, the check fixture is compiled by the
  // analyzer under test, the vitest fixture is a project run in a child process,
  // and the operations and migrations fixtures are modules imported by path.
  "ignore": [
    "test/golden/generated/**",
    "test/fixtures/check/**",
    "test/fixtures/vitest/**",
    "test/fixtures/operations/**",
    "test/fixtures/migrations/**"
  ]
}
