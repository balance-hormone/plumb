{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // The package installs its Medplum peers as devDependencies; none is imported until feature #1.
  "ignoreDependencies": ["@medplum/core", "@medplum/definitions", "@medplum/fhirtypes"],
  "workspaces": {
    // Run by .claude/settings.json, which knip does not read.
    ".": { "entry": [".claude/hooks/*.mjs"] }
  }
}
