{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": { "includes": ["**", "!**/dist", "!**/node_modules", "!**/.turbo"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "warn",
          "options": { "maxAllowedComplexity": 15 }
        }
      },
      "correctness": { "noUnusedImports": "error", "noUnusedVariables": "error" },
      "style": { "useImportType": "error" },
      "suspicious": { "noExplicitAny": "error", "noImportCycles": "error" }
    }
  },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "overrides": [
    {
      "includes": ["packages/plumb/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "plumb-kit": "plumb is the runtime at the bottom of the stack: it imports no sibling package.",
                  "plumb-zod": "plumb is the runtime at the bottom of the stack: it imports no sibling package.",
                  "plumb-operations": "plumb is the runtime at the bottom of the stack: it imports no sibling package."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/plumb-zod/**", "packages/plumb-operations/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": { "plumb-kit": "Nothing depends on the CLI: move shared code into plumb." }
              }
            }
          }
        }
      }
    }
  ]
}
