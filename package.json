{
  "name": "root",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test --workspaces",
    "lint": "biome check . && node scripts/check-headers.mjs",
    "lint:fix": "biome check --write .",
    "knip": "knip",
    "check:agnostic": "node scripts/check-agnostic.mjs",
    "check": "npm run lint && npm run typecheck && npm run knip && npm run check:agnostic && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "knip": "^6.38.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "^22.18.0 || >=24.2.0"
  },
  "type": "module"
}
