{
  "name": "plumb-kit",
  "version": "0.0.0",
  "private": true,
  "description": "The plumb CLI: pull, generate, check, push and migrate for Medplum projects.",
  "keywords": [
    "medplum",
    "fhir",
    "profiles",
    "healthcare"
  ],
  "homepage": "https://github.com/balance-hormone/plumb#readme",
  "bugs": {
    "url": "https://github.com/balance-hormone/plumb/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/balance-hormone/plumb.git",
    "directory": "packages/plumb-kit"
  },
  "license": "Apache-2.0",
  "sideEffects": false,
  "type": "module",
  "exports": {
    "import": {
      "types": "./dist/esm/index.d.ts",
      "default": "./dist/esm/index.mjs"
    },
    "require": {
      "types": "./dist/cjs/index.d.ts",
      "default": "./dist/cjs/index.cjs"
    }
  },
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.mjs",
  "types": "dist/esm/index.d.ts",
  "bin": {
    "plumb": "./dist/cjs/index.cjs"
  },
  "files": [
    "dist/cjs",
    "dist/esm"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "plumb": "0.0.0"
  },
  "devDependencies": {
    "@medplum/core": "^5.1.42",
    "@medplum/definitions": "^5.1.42",
    "@medplum/fhirtypes": "^5.1.42"
  },
  "peerDependencies": {
    "@medplum/core": "^5.1.0",
    "@medplum/definitions": "^5.1.0",
    "@medplum/fhirtypes": "^5.1.0",
    "fsh-sushi": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "fsh-sushi": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.2.0"
  }
}
