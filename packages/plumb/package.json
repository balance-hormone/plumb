{
  "name": "plumb",
  "version": "0.0.0",
  "private": true,
  "description": "Profile-typed resources, routing and typed reads for Medplum. The runtime package.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "@medplum/core": "^5.1.0",
    "@medplum/fhirtypes": "^5.1.0"
  }
}
