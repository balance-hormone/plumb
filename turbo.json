{
  "$schema": "https://turborepo.org/schema.json",
  "agentGuidance": false,
  "globalDependencies": ["tsconfig.base.json", "scripts/build.mjs"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
